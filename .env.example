# Copy to .env or export in your shell. With no keys the app runs in
# offline demo mode (bundled sample corpus + extractive answers).

# Nebius Token Factory — get a key from your Token Factory console.
# Hackathon participants: join the Nebius Builder Program for credits.
NEBIUS_API_KEY=
# OpenAI-compatible base URL of Token Factory (verify in your console):
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Any NVIDIA Nemotron model id served by Token Factory, e.g.
#   nvidia/nemotron-3-nano-30b-a3b   (fast default)
#   a Nemotron Super / Ultra id from the console catalogue (heavier reasoning)
NEBIUS_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Tavily — web search API key (https://tavily.com). Builder Program
# participants receive Tavily credits as well.
TAVILY_API_KEY=

PORT=8000
